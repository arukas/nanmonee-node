+// LookupUser resolves a UUID to the identity and password authorized right now.
+// The maps are replaced as a whole, so a reader never observes a partial update.
+func (s *Service[U]) LookupUser(userUUID [16]byte) (U, string, bool) {
+	s.userAccess.RLock()
+	defer s.userAccess.RUnlock()
+	user, loaded := s.userMap[userUUID]
+	if !loaded {
+		var zero U
+		return zero, "", false
+	}
+	return user, s.passwordMap[user], true
+}
+
+// authorized reports whether the identity still owns the same UUID credential.
+// A re-added member gets a new generation, so the old session fails this check
+// even though the UUID value is unchanged.
+func (s *Service[U]) authorized(userUUID [16]byte, user U) bool {
+	s.userAccess.RLock()
+	defer s.userAccess.RUnlock()
+	current, loaded := s.userMap[userUUID]
+	return loaded && current == user
+}
+
+func (s *Service[U]) registerSession(session *serverSession[U]) {
+	s.sessionAccess.Lock()
+	s.sessions[session] = struct{}{}
+	s.sessionAccess.Unlock()
+}
+
+func (s *Service[U]) unregisterSession(session *serverSession[U]) {
+	s.sessionAccess.Lock()
+	delete(s.sessions, session)
+	s.sessionAccess.Unlock()
+}
+
+// revokeUnauthorized closes every session whose credential disappeared. Closing
+// the QUIC connection also tears down its streams and native UDP associations,
+// so a revoked member cannot keep using an already authenticated session.
+func (s *Service[U]) revokeUnauthorized() {
+	s.sessionAccess.Lock()
+	sessions := make([]*serverSession[U], 0, len(s.sessions))
+	for session := range s.sessions {
+		sessions = append(sessions, session)
+	}
+	s.sessionAccess.Unlock()
+	for _, session := range sessions {
+		if session.revocable() {
+			session.closeWithError(E.New("user credential revoked"))
+		}
+	}
 }
 

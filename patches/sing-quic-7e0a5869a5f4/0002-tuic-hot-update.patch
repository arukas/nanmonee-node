diff --git a/tuic/service_test.go b/tuic/service_test.go
new file mode 100644
index 0000000..597fe68
--- /dev/null
+++ b/tuic/service_test.go
@@ -0,0 +1,107 @@
+package tuic
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing/common/logger"
+)
+
+func newTestService(t *testing.T) *Service[string] {
+	t.Helper()
+	service, err := NewService[string](ServiceOptions{Context: context.Background(), Logger: logger.NOP()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return service
+}
+
+func testUUID(value byte) [16]byte {
+	var id [16]byte
+	for index := range id {
+		id[index] = value
+	}
+	return id
+}
+
+// A credential update replaces both tables as a whole, and a removed member
+// stops resolving immediately even when another member keeps the same index.
+func TestUpdateUsersReplacesCredentialTables(t *testing.T) {
+	service := newTestService(t)
+	first, second := testUUID(1), testUUID(2)
+	service.UpdateUsers([]string{"m1.g1", "m2.g1"}, [][16]byte{first, second}, []string{"password-a", "password-b"})
+
+	if user, password, loaded := service.LookupUser(first); !loaded || user != "m1.g1" || password != "password-a" {
+		t.Fatalf("first credential was not stored: %q %q %v", user, password, loaded)
+	}
+	if !service.authorized(first, "m1.g1") {
+		t.Fatal("an authorized identity was rejected")
+	}
+
+	// Removing the first member keeps the second one intact and makes the old
+	// credential unresolvable.
+	service.UpdateUsers([]string{"m2.g1"}, [][16]byte{second}, []string{"password-b"})
+	if _, _, loaded := service.LookupUser(first); loaded {
+		t.Fatal("a revoked uuid was still resolvable")
+	}
+	if service.authorized(first, "m1.g1") {
+		t.Fatal("a revoked identity was still authorized")
+	}
+	if !service.authorized(second, "m2.g1") {
+		t.Fatal("removing another member revoked the remaining one")
+	}
+}
+
+// A re-added member is a new generation: the uuid resolves again but the old
+// generation must not become authorized.
+func TestAuthorizedRequiresTheSameGeneration(t *testing.T) {
+	service := newTestService(t)
+	id := testUUID(3)
+	service.UpdateUsers([]string{"m1.g1"}, [][16]byte{id}, []string{"password"})
+	service.UpdateUsers([]string{"m1.g2"}, [][16]byte{id}, []string{"password"})
+
+	if user, _, loaded := service.LookupUser(id); !loaded || user != "m1.g2" {
+		t.Fatalf("the re-added generation was not stored: %q %v", user, loaded)
+	}
+	if service.authorized(id, "m1.g1") {
+		t.Fatal("the old generation stayed authorized after a re-add")
+	}
+	if !service.authorized(id, "m1.g2") {
+		t.Fatal("the new generation was not authorized")
+	}
+}
+
+func TestRevokeUnauthorizedToleratesAnEmptyRegistry(t *testing.T) {
+	service := newTestService(t)
+	service.UpdateUsers(nil, nil, nil)
+	service.revokeUnauthorized()
+}
+
+// A credential update must not tear down a session that is still handshaking: it
+// has no identity yet, and LookupUser will judge it against the live table.
+func TestRevocableRequiresAnAuthenticatedCredential(t *testing.T) {
+	service := newTestService(t)
+	service.UpdateUsers([]string{"m1.g1"}, [][16]byte{testUUID(1)}, []string{"password"})
+
+	handshake := &serverSession[string]{Service: service, connDone: make(chan struct{}), authDone: make(chan struct{})}
+	if handshake.revocable() {
+		t.Fatal("an unauthenticated handshake was treated as revoked")
+	}
+
+	authenticated := &serverSession[string]{
+		Service:       service,
+		connDone:      make(chan struct{}),
+		authDone:      make(chan struct{}),
+		authUUID:      testUUID(1),
+		authUser:      "m1.g1",
+		authenticated: true,
+	}
+	if authenticated.revocable() {
+		t.Fatal("an authenticated member in the table was treated as revoked")
+	}
+
+	service.UpdateUsers(nil, nil, nil)
+	if !authenticated.revocable() {
+		t.Fatal("a session whose credential was removed stayed revocable=false")
+	}
+}

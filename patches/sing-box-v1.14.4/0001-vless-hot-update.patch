@@ -0,0 +1,149 @@
+package vless
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/gofrs/uuid/v5"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/inbound"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-vmess"
+	protocol "github.com/sagernet/sing-vmess/vless"
+	"github.com/sagernet/sing/common/auth"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type userUpdater interface {
+	UpdateUsers(users []option.VLESSUser) error
+}
+
+var _ userUpdater = (*Inbound)(nil)
+
+type identityCaptureRouter struct {
+	user    string
+	started chan struct{}
+	release chan struct{}
+}
+
+func (r *identityCaptureRouter) RouteConnection(context.Context, net.Conn, adapter.InboundContext) error {
+	return nil
+}
+
+func (r *identityCaptureRouter) RoutePacketConnection(context.Context, N.PacketConn, adapter.InboundContext) error {
+	return nil
+}
+
+func (r *identityCaptureRouter) RouteConnectionEx(_ context.Context, _ net.Conn, metadata adapter.InboundContext, _ N.CloseHandlerFunc) {
+	r.user = metadata.User
+	if r.started != nil {
+		close(r.started)
+		<-r.release
+	}
+}
+
+func (r *identityCaptureRouter) RoutePacketConnectionEx(_ context.Context, _ N.PacketConn, metadata adapter.InboundContext, _ N.CloseHandlerFunc) {
+	r.user = metadata.User
+}
+
+func testInbound(t *testing.T) (*Inbound, *identityCaptureRouter) {
+	t.Helper()
+	factory, err := log.New(log.Options{Options: option.LogOptions{Disabled: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	router := new(identityCaptureRouter)
+	h := &Inbound{
+		Adapter: inbound.NewAdapter("vless", "test"),
+		router:  router,
+		logger:  factory.NewLogger("test"),
+	}
+	return h, router
+}
+
+func TestAuthenticatedIdentityDoesNotDependOnUserArrayOrder(t *testing.T) {
+	h, router := testInbound(t)
+	const identity = "member-7-generation-3"
+	ctx := auth.ContextWithUser(context.Background(), identity)
+	h.newConnectionEx(ctx, nil, adapter.InboundContext{}, nil)
+	if router.user != identity {
+		t.Fatalf("authenticated identity changed: got %q, want %q", router.user, identity)
+	}
+}
+
+func TestUpdateUsersDoesNotWaitForExistingConnectionHandler(t *testing.T) {
+	h, router := testInbound(t)
+	router.started = make(chan struct{})
+	router.release = make(chan struct{})
+	h.service = protocol.NewService[string](h.logger, adapter.NewUpstreamContextHandler(h.newConnectionEx, h.newPacketConnectionEx))
+	userID, err := uuid.FromString("11111111-1111-4111-8111-111111111111")
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.service.UpdateUsers([]string{"m1.g1"}, []string{userID.String()}, []string{""})
+	var encoded bytes.Buffer
+	err = protocol.WriteRequest(&encoded, protocol.Request{UUID: userID, Command: vmess.CommandTCP, Destination: M.ParseSocksaddr("192.0.2.1:80")}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	go h.NewConnection(context.Background(), server, adapter.InboundContext{}, nil)
+	if _, err := client.Write(encoded.Bytes()); err != nil {
+		t.Fatal(err)
+	}
+	<-router.started
+
+	updated := make(chan error, 1)
+	go func() {
+		updated <- h.UpdateUsers([]option.VLESSUser{{Name: "m2.g1", UUID: "22222222-2222-4222-8222-222222222222"}})
+	}()
+	select {
+	case err := <-updated:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		close(router.release)
+		<-updated
+		t.Fatal("user update waited for an existing connection handler")
+	}
+	close(router.release)
+}
+
+func TestUpdateUsersRejectsAmbiguousCredentials(t *testing.T) {
+	h, _ := testInbound(t)
+	for name, users := range map[string][]option.VLESSUser{
+		"empty name":     {{Name: "", UUID: "11111111-1111-4111-8111-111111111111"}},
+		"invalid uuid":   {{Name: "m1.g1", UUID: "not-a-uuid"}},
+		"duplicate name": {{Name: "m1.g1", UUID: "11111111-1111-4111-8111-111111111111"}, {Name: "m1.g1", UUID: "22222222-2222-4222-8222-222222222222"}},
+		"duplicate uuid": {{Name: "m1.g1", UUID: "11111111-1111-4111-8111-111111111111"}, {Name: "m2.g1", UUID: "11111111-1111-4111-8111-111111111111"}},
+		"duplicate uuid spelled differently": {{Name: "m1.g1", UUID: "11111111-1111-4111-8111-111111111111"}, {Name: "m2.g1", UUID: "11111111111141118111111111111111"}},
+	} {
+		if err := h.UpdateUsers(users); err == nil {
+			t.Fatalf("%s: hot update accepted an ambiguous credential set", name)
+		}
+	}
+	if err := h.UpdateUsers(nil); err != nil {
+		t.Fatalf("an empty authorization must be allowed: %v", err)
+	}
+}
+
+func TestFallbackNamesCannotCollideWithExplicitOnes(t *testing.T) {
+	users := withFallbackNames([]option.VLESSUser{
+		{Name: "1", UUID: "11111111-1111-4111-8111-111111111111"},
+		{Name: "", UUID: "22222222-2222-4222-8222-222222222222"},
+	})
+	if users[0].Name != "1" || users[1].Name != "@index:1" {
+		t.Fatalf("an unnamed user did not get a reserved identity: %v", users)
+	}
+	if users[0].Name == users[1].Name {
+		t.Fatal("a fallback name collided with an explicit name")
+	}
+}

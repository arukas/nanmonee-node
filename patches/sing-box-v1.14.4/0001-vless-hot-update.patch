+// withFallbackNames copies the users and gives every unnamed one a reserved
+// index identity. A plain index string would let an explicit name such as "1"
+// collide with the fallback of another user.
+func withFallbackNames(users []option.VLESSUser) []option.VLESSUser {
+	copied := append([]option.VLESSUser(nil), users...)
+	for index := range copied {
+		if copied[index].Name == "" {
+			copied[index].Name = "@index:" + F.ToString(index)
+		}
+	}
+	return copied
+}
+
+// validateVLESSUsers enforces the hot-update contract: a stable name, a parseable
+// UUID and no shared identity, so two members cannot collapse into one entry of
+// the credential table.
+func validateVLESSUsers(users []option.VLESSUser) error {
+	names := make(map[string]struct{}, len(users))
+	// Uniqueness is checked on the parsed 16-byte value, not on the text: the
+	// same UUID written with different case or separators is one credential.
+	uuids := make(map[uuid.UUID]struct{}, len(users))
+	for _, user := range users {
+		if user.Name == "" {
+			return E.New("VLESS hot update requires a stable user name")
+		}
+		parsed, err := uuid.FromString(user.UUID)
+		if err != nil {
+			return E.Cause(err, "VLESS hot update requires a valid user UUID")
+		}
+		if _, loaded := names[user.Name]; loaded {
+			return E.New("VLESS hot update requires unique user names")
+		}
+		if _, loaded := uuids[parsed]; loaded {
+			return E.New("VLESS hot update requires unique user UUIDs")
+		}
+		names[user.Name] = struct{}{}
+		uuids[parsed] = struct{}{}
+	}
+	return nil
+}
+
+func (h *Inbound) UpdateUsers(users []option.VLESSUser) error {
+	if err := validateVLESSUsers(users); err != nil {
+		return err
+	}
+	service := vless.NewService[string](h.logger, adapter.NewUpstreamContextHandler(h.newConnectionEx, h.newPacketConnectionEx))
+	service.UpdateUsers(common.Map(users, func(it option.VLESSUser) string {
+		return it.Name
+	}), common.Map(users, func(it option.VLESSUser) string {
+		return it.UUID
+	}), common.Map(users, func(it option.VLESSUser) string {
+		return it.Flow
+	}))
+	h.serviceAccess.Lock()
+	h.service = service
+	h.serviceAccess.Unlock()
+	return nil
+}

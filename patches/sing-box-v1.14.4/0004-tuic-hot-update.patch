+}
+
+// buildTUICUsers prepares the credentials a listener starts with. Startup stays
+// as permissive as it was before hot updates existed: an unnamed user gets a
+// reserved index identity and an empty password is passed through, because only
+// the hot-update path enforces the panel contract.
+func buildTUICUsers(users []option.TUICUser) ([]string, [][16]byte, []string, error) {
+	userList := make([]string, 0, len(users))
+	userUUIDList := make([][16]byte, 0, len(users))
+	userPasswordList := make([]string, 0, len(users))
+	for index, user := range users {
+		if user.Name == "" {
+			user.Name = "@index:" + F.ToString(index)
+		}
+		userUUID, err := parseTUICUserUUID(user, index)
+		if err != nil {
+			return nil, nil, nil, err
+		}
+		userList = append(userList, user.Name)
 		userUUIDList = append(userUUIDList, userUUID)
 		userPasswordList = append(userPasswordList, user.Password)
 	}
-	service.UpdateUsers(userList, userUUIDList, userPasswordList)
-	inbound.server = service
-	inbound.userNameList = userNameList
-	return inbound, nil
+	return userList, userUUIDList, userPasswordList, nil
+}
+
+func parseTUICUserUUID(user option.TUICUser, index int) ([16]byte, error) {
+	if user.UUID == "" {
+		return [16]byte{}, E.New("missing uuid for user ", index)
+	}
+	userUUID, err := uuid.FromString(user.UUID)
+	if err != nil {
+		return [16]byte{}, E.Cause(err, "invalid uuid for user ", index)
+	}
+	return userUUID, nil
 }
 

index 0000000..95659e9
--- /dev/null
+++ b/protocol/tuic/nanmonee_hot_update_test.go
@@ -0,0 +1,78 @@
+package tuic
+
+import (
+	"testing"
+
+	"github.com/gofrs/uuid/v5"
+	"github.com/sagernet/sing-box/option"
+)
+
+// The hot-update contract is what protects a running node from a malformed
+// snapshot: a missing identity, an invalid UUID, or a duplicate key must fail
+// before the credential table is replaced.
+func TestValidateTUICUsersAcceptsStableIdentities(t *testing.T) {
+	users := []option.TUICUser{
+		{Name: "m2.g1", UUID: "22222222-2222-4222-8222-222222222222", Password: "22222222-2222-4222-8222-222222222222"},
+		{Name: "m1.g1", UUID: "11111111-1111-4111-8111-111111111111", Password: "11111111-1111-4111-8111-111111111111"},
+	}
+	names, uuids, passwords, err := validateTUICUsers(users)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(names) != 2 || names[0] != "m2.g1" || names[1] != "m1.g1" {
+		t.Fatalf("names were reordered or lost: %v", names)
+	}
+	if passwords[0] != users[0].Password || uuid.UUID(uuids[1]).String() != users[1].UUID {
+		t.Fatal("credentials were not kept index-aligned with the names")
+	}
+}
+
+func TestValidateTUICUsersRejectsBrokenSnapshots(t *testing.T) {
+	valid := option.TUICUser{Name: "m1.g1", UUID: "11111111-1111-4111-8111-111111111111", Password: "11111111-1111-4111-8111-111111111111"}
+	for name, users := range map[string][]option.TUICUser{
+		"empty name":     {{UUID: valid.UUID, Password: valid.Password}},
+		"empty uuid":     {{Name: valid.Name, Password: valid.Password}},
+		"invalid uuid":   {{Name: valid.Name, UUID: "not-a-uuid", Password: valid.Password}},
+		"empty password": {{Name: valid.Name, UUID: valid.UUID}},
+		"duplicate name": {valid, {Name: valid.Name, UUID: "22222222-2222-4222-8222-222222222222", Password: "x"}},
+		"duplicate uuid": {valid, {Name: "m2.g1", UUID: valid.UUID, Password: "x"}},
+	} {
+		users := users
+		t.Run(name, func(t *testing.T) {
+			if _, _, _, err := validateTUICUsers(users); err == nil {
+				t.Fatalf("broken snapshot %q was accepted", name)
+			}
+		})
+	}
+}
+
+// A listener that is started from a file still accepts unnamed users and empty
+// passwords; only the hot-update path enforces the panel contract.
+func TestBuildTUICUsersKeepsStartupPermissive(t *testing.T) {
+	input := []option.TUICUser{
+		{UUID: "11111111-1111-4111-8111-111111111111"},
+		{Name: "1", UUID: "22222222-2222-4222-8222-222222222222"},
+	}
+	names, uuids, passwords, err := buildTUICUsers(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(names) != 2 || names[0] != "@index:0" || names[1] != "1" {
+		t.Fatalf("startup naming regressed: %v", names)
+	}
+	if names[0] == names[1] {
+		t.Fatal("a fallback name collided with an explicit name")
+	}
+	if passwords[0] != "" || passwords[1] != "" {
+		t.Fatalf("an empty password must be accepted at startup: %v", passwords)
+	}
+	if uuid.UUID(uuids[0]).String() != "11111111-1111-4111-8111-111111111111" {
+		t.Fatalf("the uuid list is not index aligned: %v", uuids)
+	}
+	if input[0].Name != "" {
+		t.Fatal("buildTUICUsers mutated the caller's slice")
+	}
+	if _, _, _, err := buildTUICUsers([]option.TUICUser{{Name: "m1.g1", UUID: "", Password: "x"}}); err == nil {
+		t.Fatal("startup must still reject a missing uuid")
+	}
+}

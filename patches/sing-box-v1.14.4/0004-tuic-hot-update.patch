+		}
+		userUUID, err := parseTUICUserUUID(user, index)
 		if err != nil {
-			return nil, E.Cause(err, "invalid uuid for user ", index)
+			return nil, nil, nil, err
+		}
+		if _, loaded := names[user.Name]; loaded {
+			return nil, nil, nil, E.New("tuic hot update requires unique user names")
 		}
-		userList = append(userList, index)
-		userNameList = append(userNameList, user.Name)
+		if _, loaded := uuids[userUUID]; loaded {
+			return nil, nil, nil, E.New("tuic hot update requires unique user uuids")
+		}

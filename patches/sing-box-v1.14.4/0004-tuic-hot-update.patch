+// UpdateUsers replaces the accepted credentials without touching the QUIC
+// listener, so established sessions keep running while the identity set changes.
+// The authenticated identity of a session is the user name, never an array
+// index, so reordering the users cannot move a session to another member.
+func (h *Inbound) UpdateUsers(users []option.TUICUser) error {
+	userList, userUUIDList, userPasswordList, err := validateTUICUsers(users)
+	if err != nil {
+		return err
+	}
+	h.server.UpdateUsers(userList, userUUIDList, userPasswordList)
+	return nil
+}

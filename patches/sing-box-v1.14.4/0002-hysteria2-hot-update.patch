+	"github.com/sagernet/sing-box/common/listener"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-quic/hysteria2"
+	"github.com/sagernet/sing/common/auth"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	aTLS "github.com/sagernet/sing/common/tls"
+)
+
+type userUpdater interface {
+	UpdateUsers(users []option.Hysteria2User) error
+}
+
+var _ userUpdater = (*Inbound)(nil)
+
+// fakeTLSConfig satisfies aTLS.ServerConfig. These tests never perform a QUIC
+// handshake, so only the NextProtos bookkeeping that NewService relies on has to
+// behave; real QUIC coverage lives in the node runtime tests.
+type fakeTLSConfig struct{ nextProtos []string }
+
+func (c *fakeTLSConfig) ServerName() string                 { return "" }
+func (c *fakeTLSConfig) SetServerName(string)               {}
+func (c *fakeTLSConfig) NextProtos() []string               { return c.nextProtos }
+func (c *fakeTLSConfig) SetNextProtos(protos []string)      { c.nextProtos = protos }
+func (c *fakeTLSConfig) HandshakeTimeout() time.Duration    { return 0 }
+func (c *fakeTLSConfig) SetHandshakeTimeout(time.Duration)  {}
+func (c *fakeTLSConfig) STDConfig() (*stdTLS.Config, error) { return &stdTLS.Config{}, nil }
+func (c *fakeTLSConfig) Client(net.Conn) (aTLS.Conn, error) { return nil, nil }
+func (c *fakeTLSConfig) Clone() aTLS.Config                 { return c }
+func (c *fakeTLSConfig) Start() error                       { return nil }
+func (c *fakeTLSConfig) Close() error                       { return nil }
+func (c *fakeTLSConfig) Server(net.Conn) (aTLS.Conn, error) { return nil, nil }
+
+// identityCaptureRouter records the identity the inbound attached to a routed
+// connection instead of forwarding it anywhere.
+type identityCaptureRouter struct {
+	adapter.Router
+	user      string
+	source    M.Socksaddr
+	packetSet bool
+}
+
+func (r *identityCaptureRouter) RouteConnectionEx(_ context.Context, _ net.Conn, metadata adapter.InboundContext, _ N.CloseHandlerFunc) {
+	r.user = metadata.User
+	r.source = metadata.Source
+}
+
+func (r *identityCaptureRouter) RoutePacketConnectionEx(_ context.Context, _ N.PacketConn, metadata adapter.InboundContext, _ N.CloseHandlerFunc) {
+	r.user = metadata.User
+	r.source = metadata.Source
+	r.packetSet = true
+}
+
+// deferredHandler breaks the construction cycle between the service, which needs
+// a handler, and the inbound, which needs the service.
+type deferredHandler struct {
+	inner *Inbound
+}
+
+func (h *deferredHandler) NewConnectionEx(ctx context.Context, conn net.Conn, source M.Socksaddr, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	h.inner.NewConnectionEx(ctx, conn, source, destination, onClose)
+}
+
+func (h *deferredHandler) NewPacketConnectionEx(ctx context.Context, conn N.PacketConn, source M.Socksaddr, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	h.inner.NewPacketConnectionEx(ctx, conn, source, destination, onClose)
+}
+
+func testInbound(t *testing.T) (*Inbound, *identityCaptureRouter) {
+	t.Helper()
+	factory, err := log.New(log.Options{Options: option.LogOptions{Disabled: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	logger := factory.NewLogger("test")
+	router := new(identityCaptureRouter)
+	handler := new(deferredHandler)
+	service, err := hysteria2.NewService[string](hysteria2.ServiceOptions{
+		Context:   context.Background(),
+		Logger:    logger,
+		TLSConfig: new(fakeTLSConfig),
+		Handler:   handler,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	hysteriaInbound := &Inbound{
+		Adapter:  inbound.NewAdapter("hysteria2", "test"),
+		router:   router,
+		logger:   logger,
+		listener: listener.New(listener.Options{Context: context.Background(), Logger: logger}),
+		service:  service,
+	}
+	handler.inner = hysteriaInbound
+	return hysteriaInbound, router
+}
+
+func TestAuthenticatedIdentityDoesNotDependOnUserArrayOrder(t *testing.T) {
+	h, router := testInbound(t)
+	const identity = "m7.g3"
+	// Two users, so an index-based identity would resolve to a different name
+	// than the authenticated one.
+	if err := h.UpdateUsers([]option.Hysteria2User{
+		{Name: "m2.g1", Password: "22222222-2222-4222-8222-222222222222"},
+		{Name: identity, Password: "77777777-7777-4777-8777-777777777777"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	ctx := auth.ContextWithUser(context.Background(), identity)
+	h.NewConnectionEx(ctx, nil, M.Socksaddr{}, M.Socksaddr{}, nil)
+	if router.user != identity {
+		t.Fatalf("authenticated identity changed: got %q, want %q", router.user, identity)
+	}
+	// Reordering and shrinking the list must neither move a live session to
+	// another member nor index past the end of the new list.
+	if err := h.UpdateUsers([]option.Hysteria2User{
+		{Name: identity, Password: "77777777-7777-4777-8777-777777777777"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	router.user = ""
+	h.NewConnectionEx(ctx, nil, M.Socksaddr{}, M.Socksaddr{}, nil)
+	if router.user != identity {
+		t.Fatalf("identity must survive a reorder: got %q, want %q", router.user, identity)
+	}
+	router.user = ""
+	h.NewPacketConnectionEx(ctx, nil, M.Socksaddr{}, M.Socksaddr{}, nil)
+	if router.user != identity || !router.packetSet {
+		t.Fatalf("packet identity must survive a reorder: got %q, want %q", router.user, identity)
+	}
+}
+
+func TestUnknownIdentityIsNotAttributed(t *testing.T) {
+	h, router := testInbound(t)
+	if err := h.UpdateUsers([]option.Hysteria2User{{Name: "m2.g1", Password: "22222222-2222-4222-8222-222222222222"}}); err != nil {
+		t.Fatal(err)
+	}
+	// A session for a revoked generation has no identity, so the metadata stays
+	// empty and the connection tracker rejects it. It must never fall back to a
+	// different member.
+	h.NewConnectionEx(context.Background(), nil, M.Socksaddr{}, M.Socksaddr{}, nil)
+	if router.user != "" {
+		t.Fatalf("an unauthenticated request was attributed to %q", router.user)
+	}
+}
+
+func TestUpdateUsersRejectsAmbiguousCredentials(t *testing.T) {
+	h, _ := testInbound(t)
+	for name, users := range map[string][]option.Hysteria2User{
+		"empty name":      {{Name: "", Password: "11111111-1111-4111-8111-111111111111"}},
+		"empty password":  {{Name: "m1.g1", Password: ""}},
+		"duplicate name":  {{Name: "m1.g1", Password: "11111111-1111-4111-8111-111111111111"}, {Name: "m1.g1", Password: "22222222-2222-4222-8222-222222222222"}},
+		"duplicate creds": {{Name: "m1.g1", Password: "11111111-1111-4111-8111-111111111111"}, {Name: "m2.g1", Password: "11111111-1111-4111-8111-111111111111"}},
+	} {
+		if err := h.UpdateUsers(users); err == nil {
+			t.Fatalf("%s: hot update accepted an ambiguous credential set", name)
+		}
+	}
+	if err := h.UpdateUsers(nil); err != nil {
+		t.Fatalf("an empty authorization must be allowed: %v", err)
+	}
+}
+
+func TestUpdateUsersReplacesTheAcceptedCredentialSet(t *testing.T) {
+	h, _ := testInbound(t)
+	const password = "11111111-1111-4111-8111-111111111111"
+	if err := h.UpdateUsers([]option.Hysteria2User{{Name: "m1.g1", Password: password}}); err != nil {
+		t.Fatal(err)
+	}
+	if identity, loaded := h.service.LookupUser(password); !loaded || identity != "m1.g1" {
+		t.Fatalf("unexpected lookup result: %q %v", identity, loaded)
+	}
+	if err := h.UpdateUsers(nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, loaded := h.service.LookupUser(password); loaded {
+		t.Fatal("a revoked credential was still accepted")
+	}
+}
+
+func TestFallbackNamesCannotCollideWithExplicitOnes(t *testing.T) {
+	users := withFallbackNames([]option.Hysteria2User{
+		{Name: "1", Password: "11111111-1111-4111-8111-111111111111"},
+		{Name: "", Password: "22222222-2222-4222-8222-222222222222"},
+	})
+	if users[0].Name != "1" || users[1].Name != "@index:1" {
+		t.Fatalf("an unnamed user did not get a reserved identity: %v", users)
+	}
+	if users[0].Name == users[1].Name {
+		t.Fatal("a fallback name collided with an explicit name")
+	}
+}

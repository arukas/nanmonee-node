+// UpdateUsers replaces the accepted credentials without touching the QUIC
+// listener, so established sessions keep running while the identity set changes.
+// The authenticated identity of a session is the user name, never an array
+// index, so reordering the users cannot move a session to another member.
+func (h *Inbound) UpdateUsers(users []option.Hysteria2User) error {
+	userList, passwordList, err := validateHotUpdateUsers(users)
+	if err != nil {
+		return err
+	}
+	h.service.UpdateUsers(userList, passwordList)
+	return nil
+}
+
+// withFallbackNames copies the users and gives every unnamed one a reserved
+// index identity. A plain index string would let an explicit name such as "1"
+// collide with the fallback of another user.
+func withFallbackNames(users []option.Hysteria2User) []option.Hysteria2User {
+	copied := append([]option.Hysteria2User(nil), users...)
+	for index := range copied {
+		if copied[index].Name == "" {
+			copied[index].Name = "@index:" + F.ToString(index)
+		}
+	}
+	return copied
+}
+
+func validateHotUpdateUsers(users []option.Hysteria2User) ([]string, []string, error) {
+	userList := make([]string, 0, len(users))
+	passwordList := make([]string, 0, len(users))
+	names := make(map[string]struct{}, len(users))
+	passwords := make(map[string]struct{}, len(users))
+	for _, user := range users {
+		if user.Name == "" {
+			return nil, nil, E.New("hysteria2 hot update requires a stable user name")
+		}
+		if user.Password == "" {
+			return nil, nil, E.New("hysteria2 hot update requires a user password")
+		}
+		if _, loaded := names[user.Name]; loaded {
+			return nil, nil, E.New("hysteria2 hot update requires unique user names")
+		}
+		if _, loaded := passwords[user.Password]; loaded {
+			return nil, nil, E.New("hysteria2 hot update requires unique user passwords")
+		}
+		names[user.Name] = struct{}{}
+		passwords[user.Password] = struct{}{}
+		userList = append(userList, user.Name)
+		passwordList = append(passwordList, user.Password)
+	}
+	return userList, passwordList, nil
+}

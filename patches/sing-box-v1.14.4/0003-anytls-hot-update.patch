@@ -0,0 +1,38 @@
+package anytls
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+// The runtime discovers the hot-update capability through this method set.
+type userUpdater interface {
+	UpdateUsers(users []option.AnyTLSUser) error
+}
+
+var _ userUpdater = (*Inbound)(nil)
+
+func TestValidateHotUpdateUsers(t *testing.T) {
+	converted, err := validateHotUpdateUsers([]option.AnyTLSUser{{Name: "m1.g1", Password: "password-1"}})
+	if err != nil || len(converted) != 1 || converted[0].Name != "m1.g1" || converted[0].Password != "password-1" {
+		t.Fatalf("valid update rejected: %+v %v", converted, err)
+	}
+	if converted, err := validateHotUpdateUsers(nil); err != nil || len(converted) != 0 {
+		t.Fatalf("empty update must clear the table: %+v %v", converted, err)
+	}
+
+	cases := map[string][]option.AnyTLSUser{
+		"missing name":       {{Password: "password-1"}},
+		"missing password":   {{Name: "m1.g1"}},
+		"duplicate name":     {{Name: "m1.g1", Password: "password-1"}, {Name: "m1.g1", Password: "password-2"}},
+		"duplicate password": {{Name: "m1.g1", Password: "password-1"}, {Name: "m2.g1", Password: "password-1"}},
+	}
+	for name, users := range cases {
+		t.Run(name, func(t *testing.T) {
+			if _, err := validateHotUpdateUsers(users); err == nil {
+				t.Fatal("invalid update was accepted")
+			}
+		})
+	}
+}

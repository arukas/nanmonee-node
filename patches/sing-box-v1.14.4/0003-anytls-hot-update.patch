+// UpdateUsers replaces the accepted credentials without touching the TLS
+// listener, so established sessions keep running while the identity set changes.
+// The authenticated identity of a session is the user name, never an array
+// index, so reordering the users cannot move a session to another member.
+func (h *Inbound) UpdateUsers(users []option.AnyTLSUser) error {
+	converted, err := validateHotUpdateUsers(users)
+	if err != nil {
+		return err
+	}
+	h.service.UpdateUsers(converted)
+	return nil
+}
+
+func validateHotUpdateUsers(users []option.AnyTLSUser) ([]anytls.User, error) {
+	converted := make([]anytls.User, 0, len(users))
+	names := make(map[string]struct{}, len(users))
+	passwords := make(map[string]struct{}, len(users))
+	for _, user := range users {
+		if user.Name == "" {
+			return nil, E.New("anytls hot update requires a stable user name")
+		}
+		if user.Password == "" {
+			return nil, E.New("anytls hot update requires a user password")
+		}
+		if _, loaded := names[user.Name]; loaded {
+			return nil, E.New("anytls hot update requires unique user names")
+		}
+		if _, loaded := passwords[user.Password]; loaded {
+			return nil, E.New("anytls hot update requires unique user passwords")
+		}
+		names[user.Name] = struct{}{}
+		passwords[user.Password] = struct{}{}
+		converted = append(converted, anytls.User{Name: user.Name, Password: user.Password})
+	}
+	return converted, nil
+}

diff --git a/service_test.go b/service_test.go
new file mode 100644
index 0000000..89828eb
--- /dev/null
+++ b/service_test.go
@@ -0,0 +1,133 @@
+package anytls
+
+import (
+	"context"
+	"crypto/sha256"
+	"net"
+	"sync"
+	"testing"
+
+	"github.com/anytls/sing-anytls/padding"
+	"github.com/anytls/sing-anytls/session"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type discardHandler struct{}
+
+func (discardHandler) NewConnectionEx(context.Context, net.Conn, M.Socksaddr, M.Socksaddr, N.CloseHandlerFunc) {
+}
+
+func hashOf(password string) [32]byte {
+	return sha256.Sum256([]byte(password))
+}
+
+func newTestService(t *testing.T, users []User) *Service {
+	t.Helper()
+	service, err := NewService(ServiceConfig{
+		Users:         users,
+		PaddingScheme: padding.DefaultPaddingScheme,
+		Handler:       discardHandler{},
+		Logger:        logger.NOP(),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return service
+}
+
+// newTestSession builds a server session over an in-memory pipe. These tests
+// never run the session loop: they only exercise registration and revocation.
+func newTestSession(t *testing.T, service *Service) *session.Session {
+	t.Helper()
+	pipeClient, pipeServer := net.Pipe()
+	t.Cleanup(func() { _ = pipeClient.Close() })
+	return session.NewServerSession(pipeServer, func(*session.Stream) {}, &service.padding, logger.NOP())
+}
+
+func (s *Service) registeredSessions() int {
+	s.sessionAccess.Lock()
+	defer s.sessionAccess.Unlock()
+	return len(s.sessions)
+}
+
+func TestUpdateUsersClosesRevokedSession(t *testing.T) {
+	service := newTestService(t, []User{{Name: "m1.g1", Password: "password-1"}})
+	serverSession := newTestSession(t, service)
+	serverSession.SetCloseHook(func() { service.unregisterSession(serverSession) })
+	if !service.registerSession(serverSession, hashOf("password-1")) {
+		t.Fatal("an authorized credential was refused")
+	}
+	if service.registeredSessions() != 1 {
+		t.Fatal("session was not registered")
+	}
+
+	service.UpdateUsers([]User{{Name: "m1.g1", Password: "password-2"}})
+	if !serverSession.IsClosed() {
+		t.Fatal("revoked session must be closed by the update")
+	}
+	if service.registeredSessions() != 0 {
+		t.Fatal("closed session must unregister itself")
+	}
+	if _, loaded := service.LookupUser(hashOf("password-1")); loaded {
+		t.Fatal("revoked credential must not be accepted")
+	}
+	if user, loaded := service.LookupUser(hashOf("password-2")); !loaded || user != "m1.g1" {
+		t.Fatalf("rotated credential missing: %q %v", user, loaded)
+	}
+}
+
+func TestUpdateUsersKeepsAuthorizedSession(t *testing.T) {
+	service := newTestService(t, []User{{Name: "m1.g1", Password: "password-1"}})
+	serverSession := newTestSession(t, service)
+	serverSession.SetCloseHook(func() { service.unregisterSession(serverSession) })
+	if !service.registerSession(serverSession, hashOf("password-1")) {
+		t.Fatal("an authorized credential was refused")
+	}
+	service.UpdateUsers([]User{{Name: "m1.g2", Password: "password-1"}})
+	if serverSession.IsClosed() {
+		t.Fatal("a session whose credential survived the update must keep running")
+	}
+	if user, loaded := service.LookupUser(hashOf("password-1")); !loaded || user != "m1.g2" {
+		t.Fatalf("identity was not replaced: %q %v", user, loaded)
+	}
+}
+
+func TestRegisterSessionRefusesRevokedCredential(t *testing.T) {
+	service := newTestService(t, nil)
+	serverSession := newTestSession(t, service)
+	serverSession.SetCloseHook(func() { service.unregisterSession(serverSession) })
+	if service.registerSession(serverSession, hashOf("password-1")) {
+		t.Fatal("an unknown credential was registered")
+	}
+	if !serverSession.IsClosed() {
+		t.Fatal("a session registered with an unknown credential must be closed")
+	}
+	if service.registeredSessions() != 0 {
+		t.Fatal("a refused session must not stay registered")
+	}
+}
+
+func TestUpdateUsersAndLookupAreRaceFree(t *testing.T) {
+	service := newTestService(t, []User{{Name: "m1.g1", Password: "password-1"}})
+	serverSession := newTestSession(t, service)
+	serverSession.SetCloseHook(func() { service.unregisterSession(serverSession) })
+	service.registerSession(serverSession, hashOf("password-1"))
+
+	var wait sync.WaitGroup
+	for index := 0; index < 8; index++ {
+		wait.Add(1)
+		go func(index int) {
+			defer wait.Done()
+			password := "password-1"
+			if index%2 == 0 {
+				password = "password-2"
+			}
+			service.UpdateUsers([]User{{Name: "m1.g1", Password: password}})
+			service.LookupUser(hashOf(password))
+			service.UpdateUsers([]User{{Name: "m1.g1", Password: "password-1"}})
+		}(index)
+	}
+	wait.Wait()
+}

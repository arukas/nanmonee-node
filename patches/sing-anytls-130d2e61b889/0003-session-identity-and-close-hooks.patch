 }
+
+func TestStreamHookInstalledAfterCloseRunsOnce(t *testing.T) {
+	stream := newStream(1, nil)
+	stream.closeLocally()
+	var calls atomic.Int32
+	for i := 0; i < 2; i++ {
+		stream.setDieHook(func() { calls.Add(1) })
+	}
+	if calls.Load() != 1 {
+		t.Fatalf("late stream hook calls = %d, want 1", calls.Load())
+	}
+}
+
+func TestSessionHookInstalledAfterCloseRunsOnce(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	session := &Session{conn: server, die: make(chan struct{}), streams: make(map[uint32]*Stream)}
+	_ = session.Close()
+	var calls atomic.Int32
+	for i := 0; i < 2; i++ {
+		session.SetCloseHook(func() { calls.Add(1) })
+	}
+	if calls.Load() != 1 {
+		t.Fatalf("late session hook calls = %d, want 1", calls.Load())
+	}
+}

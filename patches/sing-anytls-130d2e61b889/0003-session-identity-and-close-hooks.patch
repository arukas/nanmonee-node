 package session
 
 import (
+	"net"
 	"sync"
 	"sync/atomic"
 	"testing"
@@ -29,3 +30,29 @@ func TestStreamDieHookIsInstalledOnce(t *testing.T) {
 		t.Fatalf("the hook ran more than once: %d", calls.Load())

+func TestUpdateUsersClosesSessionWhoseIdentityChanged(t *testing.T) {
+	service := newTestService(t, []User{{Name: "m1.g1", Password: "password-1"}})
+	serverSession := newTestSession(t, service)
+	serverSession.SetCloseHook(func() { service.unregisterSession(serverSession) })
+	if !service.registerSession(serverSession, hashOf("password-1"), "m1.g1") {
+		t.Fatal("an authorized credential was refused")
+	}
+	service.UpdateUsers([]User{{Name: "m2.g1", Password: "password-1"}})
+	if !serverSession.IsClosed() {
+		t.Fatal("a session bound to the old identity survived credential reassignment")
+	}
+}
+
+func TestRegistrationRefusesAStaleIdentityWithTheSamePassword(t *testing.T) {
+	service := newTestService(t, []User{{Name: "m2.g1", Password: "password-1"}})
+	serverSession := newTestSession(t, service)
+	serverSession.SetCloseHook(func() { service.unregisterSession(serverSession) })
+	if service.registerSession(serverSession, hashOf("password-1"), "m1.g1") || !serverSession.IsClosed() {
+		t.Fatal("registration accepted an identity from before the credential update")
+	}
+}

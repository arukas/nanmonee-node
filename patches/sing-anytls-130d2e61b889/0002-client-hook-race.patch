diff --git a/session/hook_test.go b/session/hook_test.go
new file mode 100644
index 0000000..546728e
--- /dev/null
+++ b/session/hook_test.go
@@ -0,0 +1,31 @@
+package session
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+// The client installs the die hook after the session loop can already close the
+// stream. Without the lock this test races under -race and the hook can be lost.
+func TestStreamDieHookIsInstalledOnce(t *testing.T) {
+	stream := newStream(1, nil)
+	var calls atomic.Int32
+	var wait sync.WaitGroup
+	for index := 0; index < 8; index++ {
+		wait.Add(2)
+		go func() {
+			defer wait.Done()
+			stream.setDieHook(func() { calls.Add(1) })
+		}()
+		go func() {
+			defer wait.Done()
+			stream.closeLocally()
+		}()
+	}
+	wait.Wait()
+	stream.closeLocally()
+	if calls.Load() > 1 {
+		t.Fatalf("the hook ran more than once: %d", calls.Load())
+	}
+}
